# Production image for the FastAPI backend.
#
#   docker build -f Dockerfile.api -t analyst-api .
#   docker run -p 8000:8000 --env-file .env analyst-api
#
# No API key is ever baked into this image: it is supplied at container
# *run* time via --env-file / docker-compose's env_file, never COPYed in.

FROM python:3.12-slim

# Don't write .pyc files or buffer stdout/stderr, so container logs show up
# immediately and no bytecode cache clutters the image.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# pyproject.toml is the project's one dependency list; nothing is
# duplicated here. README.md is required only because pyproject.toml
# references it as the package long description.
COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir .

# Run as an unprivileged user rather than root.
RUN useradd --create-home --uid 1000 appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Shell form so $PORT is read at container start: most PaaS platforms
# (Render, Railway, etc.) inject PORT and expect the app to bind to it.
# Falls back to 8000 for plain `docker run` / docker-compose, which don't
# set it.
CMD uvicorn analyst.api:app --host 0.0.0.0 --port ${PORT:-8000}
