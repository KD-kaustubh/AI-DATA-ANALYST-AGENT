# Copy this file to .env and add your keys. Never commit .env.

# Optional. "gemini" or "groq".
# When unset, whichever provider has a key is used, preferring gemini if both do.
LLM_PROVIDER=gemini

# --- Google Gemini ---
GOOGLE_API_KEY=

# Optional. Defaults to gemini-2.5-flash when unset.
MODEL_NAME=gemini-2.5-flash

# --- Groq ---
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile when unset.
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# --- Backend (optional) ---
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Frontend (optional) ---
# Where the Streamlit app looks for the backend.
ANALYST_API_URL=http://127.0.0.1:8000
